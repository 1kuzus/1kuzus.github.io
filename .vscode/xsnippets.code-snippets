    "X.CodeBlock tag": {
        "scope": "javascript,typescript",
        "prefix": "xc",
        "body": [
            "<X.CodeBlock",
            "\tlanguage=\"$1\"",
            "\tcode={String.raw`$2",
            "\t`}",
            "/>",
        ],
        "description": "X.CodeBlock tag"
    },
    "X.CodeBlock tag (oneline)": {
        "scope": "javascript,typescript",
        "prefix": "xco",
        "body": [
            "<X.CodeBlock language=\"$1\" code=\"$2\" />",
        ],
        "description": "X.CodeBlock tag (oneline)"
    },
