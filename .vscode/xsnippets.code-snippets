    "X.Image tag": {
        "scope": "javascript,typescript",
        "prefix": "ximage",
        "body": [
            "<X.Image src=\"fig1$1.jpg\" width=\"100%\" />",
        ],
        "description": "X.Image tag"
    },
    "X.Table tag": {
        "scope": "javascript,typescript",
        "prefix": "xtable",
        "body": [
            "<X.Table>",
            "\t<tr>",
            "\t\t<th>$1</th>",
            "\t</tr>",
            "\t<tr>",
            "\t\t<td></td>",
            "\t</tr>",
            "</X.Table>",
        ],
        "description": "X.Table tag"
    },
    "X.Table tag with fromText props": {
        "scope": "javascript,typescript",
        "prefix": "xtft",
        "body": [
            "<X.Table",
            "\tfromText={`",
            "\t'index'|列一|列二$1",
            "\t行一|@百度[https://www.baidu.com]@|你好*世界*",
            "\t行二|$(x+y)^2$|'Hello, World!'",
            "\t`}",
            "/>",
        ],
        "description": "X.Table tag with fromText props"
    },
    "X.Table tag with fromData props": {
        "scope": "javascript,typescript",
        "prefix": "xtfd",
        "body": [
            "<X.Table",
            "\tfromData={[",
            "\t\t['列一', '列二'],$1",
            "\t\t['*你好*', '世界'],",
            "\t\t[<X.CodeBlock language=\"python\" code=\"print('hello')\" />, '$(x+y)^2$'],",
            "\t\t[",
            "\t\t\t'`Hello, World!`',",
            "\t\t\t<>",
            "\t\t\t\t<X.P>lorem ipsum dolor sit amet</X.P>",
            "\t\t\t\t<X.Formula text=\"x^2+y^2+2xy\" />",
            "\t\t\t\t<X.HighlightBlock>",
            "\t\t\t\t\t<X.P>`consectetur adipiscing elit`</X.P>",
            "\t\t\t\t</X.HighlightBlock>",
            "\t\t\t</>",
            "\t\t]",
            "\t]}",
            "/>",
        ],
        "description": "X.Table tag with fromData props"
    },
    "@xprops": {
